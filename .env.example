# ==========================================
# DeepSeek API Configuration
# ==========================================
DEEPSEEK_API_KEY=your_api_key_here

# ==========================================
# Local LLM(vLLM) Configuration
# ==========================================
LLM_API_KEY=your_api_key_here

# ==========================================
# Agent PostgreSQL
# ==========================================
AGENT_DB_NAME=cvhub_agent
AGENT_DB_USER=cvhub_agent
AGENT_DB_PASSWORD=replace_with_your_secure_password
AGENT_DB_PORT=18010

# ==========================================
# LangGraph Checkpointer (local development)
# ==========================================
AGENT_DATABASE_URL=postgresql://cvhub_agent:replace_with_your_secure_password@127.0.0.1:18010/cvhub_agent